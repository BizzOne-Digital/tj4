MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/central-pa-lions
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-run

# --- SMTP (form notifications) ---
# Gmail: enable 2FA, create App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM="Central PA Lions Academy <your@gmail.com>"

# Legacy aliases (optional — same as SMTP_USER / SMTP_PASSWORD)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

CONTACT_RECEIVER_EMAIL=tjandersty@gmail.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public URL (production: https://your-domain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — not required for MongoDB image uploads
